+// Os arquivos podem ser lidos em paralelo. Relata os erros na ordem dos argumentos.
+array<vector<Amostra>, 2> ler_conjuntos(const string& arquivo_treino, const string& arquivo_teste) {
+#ifdef _OPENMP
+    if (omp_get_max_threads() > 1) {
+        const array<const string*, 2> caminhos{&arquivo_treino, &arquivo_teste};
+        array<vector<Amostra>, 2> conjuntos;
+        array<exception_ptr, 2> erros{};
+        #pragma omp parallel for num_threads(2) schedule(static)
+        for (int i = 0; i < 2; ++i) {
+            try {
+                conjuntos[i] = ler_dados(*caminhos[i]);
+            } catch (...) {
+                erros[i] = current_exception();
+            }
+        }
+        for (const auto& erro : erros) {
+            if (erro) {
+                rethrow_exception(erro);
+            }
+        }
+        return conjuntos;
+    }
+#endif
+    return {ler_dados(arquivo_treino), ler_dados(arquivo_teste)};
+}
